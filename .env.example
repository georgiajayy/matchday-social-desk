# Copy this file to .env and fill in your own values. Never commit your real .env.

# Microsoft Foundry: your resource's Azure OpenAI endpoint and key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Optional: natural commentator voice (deploy gpt-audio-mini in Foundry)
AZURE_AUDIO_DEPLOYMENT=gpt-audio-mini
# AZURE_AUDIO_VOICE=ash

# Optional: Azure AI Speech fallback voice. The region of your resource, e.g. eastus2
AZURE_SPEECH_REGION=eastus2
# AZURE_SPEECH_KEY=only-if-you-use-a-separate-speech-resource

# Set to 1 to run everything offline with placeholder text (no Azure needed)
MOCK_AI=0
